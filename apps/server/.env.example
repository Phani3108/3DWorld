# Copy to apps/server/.env for local development.
PORT=4000
# Keep dev data between restarts (unset = in-memory; wiped on restart).
PGLITE_DIR=.data/pglite
# Production: Neon Postgres connection string (overrides PGlite).
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
CORS_ORIGINS=http://localhost:5180
TRUST_PROXY=0
ROOM_CAPACITY=40
RESIDENT_REPLY_DELAY_MS=700
